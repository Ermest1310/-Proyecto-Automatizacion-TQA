# Copy to .env.local and supply your LOCAL QA values. Never commit .env.local.
APP_URL=http://127.0.0.1:8187
QA_APP_SOURCE=E:/laragon/www/Proyecto2
QA_PHP=php
QA_DB_HOST=127.0.0.1
QA_DB_PORT=3306
QA_DB_DATABASE=gimnasia_unificada_test
QA_DB_USER=
QA_DB_PASSWORD=
QA_MYSQL_CLI=E:/laragon/laragon/bin/mysql/mysql-8.4.3-winx64/bin/mysql.exe
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_ADMIN_ID=
QA_JUDGE_EMAIL=
QA_JUDGE_PASSWORD=
QA_JUDGE_ID=
QA_ATHLETE_EMAIL=
QA_ATHLETE_PASSWORD=
QA_ATHLETE_ID=
QA_GUEST_EMAIL=
QA_GUEST_PASSWORD=
QA_GUEST_ID=
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
QA_API_TOKEN=
QA_BACKEND_PORT=9876
QA_RUN_TIMEOUT_MS=900000
# Optional: installed Playwright browser cache and legacy Selenium example.
PLAYWRIGHT_BROWSERS_PATH=
QA_DEMO_USERNAME=
QA_DEMO_PASSWORD=

# Email: off (default), local (loopback demo), smtp (external with mandatory TLS).
QA_MAIL_MODE=off
QA_SMTP_HOST=
QA_SMTP_PORT=
QA_SMTP_TLS=starttls
QA_SMTP_USER=
QA_SMTP_PASSWORD=
QA_MAIL_FROM=
# Local demonstration only: mode=local, host=127.0.0.1, port=1025, recipient @localhost.test.
# External SMTP: implicit TLS (usually 465) or required STARTTLS (usually 587).

# Plataforma integral: mantener CI secreto en .env.local; qa:configure lo genera sin mostrarlo.
QA_MAX_WORKERS=1
QA_CI_WEBHOOK_SECRET=
# IA opcional: desactivada por defecto; no se reutilizan claves de Laravel.
QA_AI_ENABLED=false
QA_AI_API_KEY=
QA_AI_MODEL=

# Gemini: clave privada solo en .env.local, nunca en el navegador.
QA_AI_PROVIDER=gemini
QA_AI_ENABLED=true
QA_GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
